# Dev: leave empty so requests use /api/* on the Vite dev server (proxied to http://localhost:5050).
# Or set to http://localhost:5050 for direct backend calls (requires CORS on the API).
VITE_API_BASE_URL=

# Set to true to log request URL, payload, and response in the browser console
VITE_API_DEBUG=false

# Optional Bearer for POST /api/admin/login (only if your backend requires it)
VITE_API_LOGIN_BEARER_TOKEN=
