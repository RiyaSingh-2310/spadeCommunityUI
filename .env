# Frontend Vite configuration. Loaded for every mode (dev, test, production).
# Machine-specific overrides belong in .env.local (gitignored), for example a
# local API: VITE_API_BASE_URL=http://localhost:5050
#
# Do not put encryption keys, JWT secrets, or backend credentials here.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# Shared API for this project. Production builds reject localhost.
#VITE_API_BASE_URL=https://backhand-spade-community.onrender.com/api
VITE_API_BASE_URL=http://localhost:5050

# Dev-only request logging. Production builds never enable this even if true.
VITE_API_DEBUG=false

# Optional Bearer for POST /api/admin/login (only if the backend requires it)
VITE_API_LOGIN_BEARER_TOKEN=

# TinyMCE Cloud API key for the admin rich text editor
VITE_TINYMCE_API_KEY=74nz0rvyzynmmg8392gqeer6nixxwjsawr42r8049ajgo968

# Panelist id used in Questionnaire Group Website URL links
# /public/questionnaire/{groupId}?panelist_id={panelistId}
VITE_QUESTIONNAIRE_GROUP_PANELIST_ID=30
