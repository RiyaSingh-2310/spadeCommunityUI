# Copy to .env.local for machine-specific overrides (gitignored).
# Development: .env.development is used by `npm run dev`.
# Production: .env.production is used by `npm run build`.
#
# Do not put encryption keys, JWT secrets, or other credentials in VITE_* variables.
# Anything prefixed with VITE_ is exposed in the browser bundle.

VITE_API_BASE_URL=http://localhost:5050
VITE_API_DEBUG=false
VITE_TINYMCE_API_KEY=
VITE_QUESTIONNAIRE_GROUP_PANELIST_ID=
