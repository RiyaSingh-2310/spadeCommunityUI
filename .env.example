# API origin — do NOT include /api here (routes already start with /api/...)
# Dev: leave empty to use Vite proxy (see vite.config.js server.proxy)
# Prod: set to your API host, e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:5050

# Aliases also supported: VITE_API_URL, REACT_APP_API_URL, NEXT_PUBLIC_API_URL

# Dev-only: log API request URL, payload, and response (true/false)
VITE_API_DEBUG=false

# Optional Bearer sent on login + forgot-password / verify-otp / reset-password
VITE_API_LOGIN_BEARER_TOKEN=
