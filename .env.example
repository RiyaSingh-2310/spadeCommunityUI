# Frontend Vite configuration (copy to .env or .env.local).
# Values prefixed with VITE_ are exposed to the browser bundle.
# Do not put JWT secrets, DB passwords, or SMTP credentials here.

# API base URL (no trailing slash). Production builds reject localhost.
VITE_API_BASE_URL=https://your-api.example.com/api

# Dev-only request logging (production builds ignore this).
VITE_API_DEBUG=false

# Optional Bearer for pre-auth endpoints if the backend requires it.
VITE_API_LOGIN_BEARER_TOKEN=

# TinyMCE Cloud API key for the admin rich text editor
VITE_TINYMCE_API_KEY=

# Panelist id used in Questionnaire Group Website URL links
VITE_QUESTIONNAIRE_GROUP_PANELIST_ID=
