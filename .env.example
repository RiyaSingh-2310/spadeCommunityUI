# Copy to .env.development (local) or set in your host (Vercel, etc.).
# Never commit real secrets. Keys below are placeholders — rotate any values
# that were previously committed to git.

# API base (with or without trailing /api — buildApiUrl normalizes)
VITE_API_BASE_URL=http://localhost:5050

# Client-side payload obfuscation keys (must match backend ENCRYPTION_KEY1 / KEY2).
# WARNING: Vite inlines these into the public JS bundle — they are NOT secret.
# Prefer HTTPS/TLS for real transport security. Plan to remove client-side
# password encryption once the backend accepts plaintext over TLS.
VITE_ENCRYPTION_KEY1=
VITE_ENCRYPTION_KEY2=

# Dev-only request/response console logging (never enable in production builds)
VITE_API_DEBUG=false

# Optional static Bearer for pre-auth endpoints (forgot-password / some logins).
# Also public in the bundle — do not treat as a real secret. Prefer server-side
# rate limiting / CAPTCHA instead (see M4).
VITE_API_LOGIN_BEARER_TOKEN=

# TinyMCE Cloud API key for the admin rich text editor
VITE_TINYMCE_API_KEY=

# Panelist id used in Questionnaire Group Website URL links
# /public/questionnaire/{groupId}?panelist_id={panelistId}
VITE_QUESTIONNAIRE_GROUP_PANELIST_ID=
